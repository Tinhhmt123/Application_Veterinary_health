<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tên chi nhánh phòng khám" />

    <EditText
        android:id="@+id/edtAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Địa chỉ đầy đủ" />

    <EditText
        android:id="@+id/edtPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Số điện thoại Hotline"
        android:inputType="phone" />

    <EditText
        android:id="@+id/edtOpenHours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giờ mở cửa (VD: 08:00 - 20:00)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edtLatitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Vĩ độ (Latitude)"
            android:inputType="numberDecimal|numberSigned" />

        <EditText
            android:id="@+id/edtLongitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Kinh độ (Longitude)"
            android:inputType="numberDecimal|numberSigned" />
    </LinearLayout>

</LinearLayout>