<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <!-- ==================== 1. HEADER CỦA USER ==================== -->
    <LinearLayout
        android:id="@+id/headerUser"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/emerald_600"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUserHeaderBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUserOpenDrawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🐾"
                android:textSize="18sp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutUserHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Healthy Pet"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUserHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Cảnh báo y tế &amp; Sổ tiêm chủng"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 2. CONTENT Ở GIỮA CỦA USER ==================== -->
    <FrameLayout
        android:id="@+id/userContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ==================== 3. FOOTER (THANH MENU CONG BÊN DƯỚI) CỦA USER ==================== -->
    <com.example.healthy_pet.ui.component.CurvedBottomNavView
        android:id="@+id/footerUser"
        android:layout_width="match_parent"
        android:layout_height="78dp" />

</LinearLayout>
