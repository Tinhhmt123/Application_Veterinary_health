<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#3364748B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:cardBackgroundColor="@color/emerald_50"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#334F46E5"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgClinic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh chi nhánh"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_clinic_building" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClinicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Healthy Pet Quận 1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClinicAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvClinicPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/emerald_500"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClinicOpenHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvClinicLatLng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_indigo"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/indigo_600"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEditClinic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_indigo"
                android:contentDescription="Sửa chi nhánh"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/indigo_600" />

            <ImageButton
                android:id="@+id/btnDeleteClinic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_red"
                android:contentDescription="Xóa chi nhánh"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/red_600" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>