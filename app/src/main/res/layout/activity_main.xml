<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== KHUNG CHỨA TRANG CHÍNH (Login / Page_User / Page_Admin) ==================== -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ==================== MENU TRƯỢT BÊN TRÁI (OVERLAY DRAWER) ==================== -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drawer Header hiển thị Avatar tròn + Họ tên + Email của người đang đăng nhập -->
            <LinearLayout
                android:id="@+id/layoutDrawerHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/emerald_700"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivDrawerUserAvatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Ảnh đại diện người dùng"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher_round" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Healthy Pet"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDrawerUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cài đặt • Theme • Trợ lý AI"
                        android:textColor="#D1FAE5"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mục 1: Theme (Sáng / Tối) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 GIAO DIỆN (THEME)"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chế độ Ban đêm (Dark Mode)"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#3364748B" />

                <!-- Mục 2: Cài đặt (Settings) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ CÀI ĐẶT HỆ THỐNG"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAlert7Days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Tự động cảnh báo tiêm trước 7 ngày"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#3364748B" />

                <!-- Mục 3: Trợ giúp & Trợ lý AI Thú Y -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 TRỢ GIÚP &amp; TRỢ LÝ AI THÚ Y"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiAnswerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/emerald_50"
                    android:padding="12dp"
                    android:text="🤖 AI Bác Sĩ Thú Y: Chào bạn! Hãy chọn câu hỏi nhanh bên dưới để được tư vấn sơ cứu cho thú cưng."
                    android:textColor="@color/slate_800"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiFaq1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🐕 Chó bỏ ăn, nôn dịch vàng?"
                    android:textAllCaps="false"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    app:strokeColor="@color/emerald_500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiFaq2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="💉 Lịch tiêm phòng chuẩn cho chó/mèo?"
                    android:textAllCaps="false"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    app:strokeColor="@color/emerald_500" />

                <!-- Nút Đăng xuất nhanh ngay trên Menu trượt -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDrawerLogout"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🚪 Đăng xuất tài khoản"
                    android:textAllCaps="false"
                    android:textColor="@color/red_600"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/red_600" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Đóng Menu ←"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>