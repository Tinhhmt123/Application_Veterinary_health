<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ==================== LỚP CHÍNH: TOOLBAR + FRAGMENT + BOTTOM BAR ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Toolbar: Bấm biểu tượng App (🐾) để mở Menu trượt bên trái -->
        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/emerald_600"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAppIconMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white"
                app:strokeWidth="1.5dp">

                <TextView
                    android:id="@+id/tvAppIconEmoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🐾"
                    android:textSize="18sp" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutTitleClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Healthy Pet (Menu ≡)"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToolbarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="NV 3: Cảnh báo y tế 7 ngày"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Nút chuyển nhanh chế độ USER / ADMIN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchRole"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="USER ⇄ ADMIN"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/white" />
        </LinearLayout>

        <!-- Vùng chứa Fragment của 8 Nghiệp vụ -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Bar cho USER (5 mục trên 1 hàng, nút Đặt lịch ở giữa nổi bật) -->
        <LinearLayout
            android:id="@+id/bottomNavUser"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/navUserAlert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavUserAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Cảnh báo"
                    android:textColor="@color/emerald_500"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navUserPet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🐶" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavUserPet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Thú cưng"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Nút ĐẶT LỊCH ở giữa nổi bật hơn các nút khác -->
            <LinearLayout
                android:id="@+id/navUserBookingCenter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBookingCenter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="@color/emerald_600"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/amber_500"
                    app:strokeWidth="2dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="📅"
                        android:textSize="17sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNavUserBooking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Đặt lịch"
                    android:textColor="@color/emerald_500"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navUserMedical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavUserMedical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Bệnh án"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navUserAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👤" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavUserAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Tài khoản"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Bar cho ADMIN (3 mục: NV 6, NV 7, NV 8) -->
        <LinearLayout
            android:id="@+id/bottomNavAdmin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/navAdminUserPet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavAdminUserPet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="User &amp; Pet"
                    android:textColor="@color/emerald_500"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAdminAppointment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🩺" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavAdminAppointment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Duyệt lịch &amp; Đơn"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navAdminClinic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏥" android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNavAdminClinic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="Chi nhánh"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== MENU TRƯỢT BÊN TRÁI (OVERLAY DRAWER - KHÔNG ẢNH HƯỞNG UI KHÁC) ==================== -->
    <ScrollView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Drawer Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/emerald_700"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐾 Healthy Pet Menu"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cài đặt • Theme • Trợ lý AI Thú Y"
                    android:textColor="#D1FAE5"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Mục 1: Theme (Sáng / Tối) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 GIAO DIỆN (THEME)"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chế độ Ban đêm (Dark Mode)"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#3364748B" />

                <!-- Mục 2: Cài đặt (Settings) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ CÀI ĐẶT HỆ THỐNG"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAlert7Days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Tự động cảnh báo tiêm trước 7 ngày"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#3364748B" />

                <!-- Mục 3: Trợ giúp & Trợ lý AI Thú Y -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 TRỢ GIÚP &amp; TRỢ LÝ AI THÚ Y"
                    android:textColor="@color/emerald_500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiAnswerBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/emerald_50"
                    android:padding="12dp"
                    android:text="🤖 AI Bác Sĩ Thú Y: Chào bạn! Hãy chọn câu hỏi nhanh bên dưới để được tư vấn sơ cứu cho thú cưng."
                    android:textColor="@color/slate_800"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiFaq1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🐕 Chó bỏ ăn, nôn dịch vàng?"
                    android:textAllCaps="false"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    app:strokeColor="@color/emerald_500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiFaq2"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="💉 Lịch tiêm phòng chuẩn cho chó/mèo?"
                    android:textAllCaps="false"
                    android:textAlignment="viewStart"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="12sp"
                    app:strokeColor="@color/emerald_500" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Đóng Menu ←"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
