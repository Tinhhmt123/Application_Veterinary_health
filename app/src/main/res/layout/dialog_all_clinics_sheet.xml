<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <!-- Thanh nắm kéo (Drag Handle) đặc trưng của thẻ trượt -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#4D64748B"
        app:cardCornerRadius="3dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Tiêu đề + Nút đóng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAllClinicsSheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏥 Tất cả chi nhánh phòng khám"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAllClinicsSheetSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Vuốt trượt để xem chi tiết, chạm thẻ để bay tới ghim trên bản đồ"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseAllClinicsSheet"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="✕"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:strokeColor="#3364748B" />
    </LinearLayout>

    <!-- Ô tìm kiếm nhanh chi nhánh -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:hint="🔍 Tìm theo tên hoặc địa chỉ chi nhánh..."
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchAllClinics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingVertical="10dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13.5sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvEmptyAllClinicsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Không tìm thấy chi nhánh phù hợp."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Danh sách trượt toàn bộ thẻ chi nhánh -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllClinicsSheet"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:scrollbars="vertical" />

</LinearLayout>
