<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#3364748B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Ảnh đại diện tròn của khách hàng -->
        <ImageView
            android:id="@+id/ivItemUserAvatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="Ảnh đại diện khách hàng"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher_round" />

        <!-- Khối thông tin Họ tên, Email, SĐT, Trạng thái -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemUserFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn Tính"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="tinh@gmail.com"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvItemUserPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SĐT: 0987654321"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <!-- Hàng hiển thị nhãn Quyền & Trạng thái hoạt động -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/slate_100"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="USER"
                    android:textColor="@color/slate_800"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemUserStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@color/emerald_100"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Đang hoạt động"
                    android:textColor="@color/emerald_700"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút Khóa / Mở khóa tài khoản -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleUserLock"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="88dp"
            android:paddingHorizontal="10dp"
            android:text="🔒 Khóa"
            android:textAllCaps="false"
            android:textColor="@color/red_600"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/red_600" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
