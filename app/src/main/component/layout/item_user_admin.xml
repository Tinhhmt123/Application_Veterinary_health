<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#E2EAF2"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#8295A8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/slate_100"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#334F46E5"
            app:strokeWidth="1.5dp">

            <ImageView
                android:id="@+id/ivItemUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh đại diện khách hàng"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemUserFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Văn Tính"
                android:textColor="#071421"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="tinh@gmail.com"
                android:textColor="#1C3042"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemUserPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SĐT: 0987654321"
                android:textColor="#263B50"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_slate"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="USER"
                    android:textColor="@color/slate_800"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemUserStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pet_weight_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Đang hoạt động"
                    android:textColor="@color/emerald_700"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleUserLock"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:maxLines="1"
            android:minWidth="86dp"
            android:paddingHorizontal="12dp"
            android:text="🔒 Khóa"
            android:textAllCaps="false"
            android:textColor="@color/red_600"
            android:textSize="12sp"
            app:cornerRadius="17dp"
            app:strokeColor="@color/red_600" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
