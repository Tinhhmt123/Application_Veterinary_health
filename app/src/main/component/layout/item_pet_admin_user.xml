<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#3364748B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardItemPetAvatarRing"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="@color/emerald_50"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#4D10B981"
            app:strokeWidth="1.5dp">

            <ImageView
                android:id="@+id/ivItemPetAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh thú cưng"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Cột thông tin thú cưng ở giữa -->
        <LinearLayout
            android:id="@+id/layoutItemPetInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemPetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Milu"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvItemPetWeightBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pet_weight_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="14.5 kg"
                    android:textColor="@color/emerald_700"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemPetSpeciesBreed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chó • Golden Retriever • Đực"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvItemPetBirthDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ngày sinh: 2024-05-10"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemPetOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Chủ: Nguyễn Văn Tính • 0908123456"
                android:textColor="@color/indigo_600"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Cột nút thao tác nằm bên phải thông tin pet (mặc định GONE, hiện khi hover 3s hoặc chạm) -->
        <LinearLayout
            android:id="@+id/layoutItemPetActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPetWeight"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="96dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingTop="0dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0dp"
                android:text="⚖️ Cân nặng"
                android:textAllCaps="false"
                android:textColor="@color/emerald_700"
                android:textSize="11sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/emerald_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPetEdit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="96dp"
                android:layout_height="28dp"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingTop="0dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0dp"
                android:text="Sửa"
                android:textAllCaps="false"
                android:textColor="@color/indigo_600"
                android:textSize="11sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/indigo_600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPetDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="96dp"
                android:layout_height="28dp"
                android:ellipsize="end"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:maxLines="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingTop="0dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0dp"
                android:text="Xóa"
                android:textAllCaps="false"
                android:textColor="@color/red_600"
                android:textSize="11sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/red_600" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
