# =========================================================================
# FILE MẪU CHO CÁC THÀNH VIÊN TRONG NHÓM (Copy file này thành tên ".env")
# =========================================================================

# 1. Cấu hình SQL Server trên máy cá nhân của mỗi thành viên
DB_NAME=HealthyPetDB
DB_USERNAME=sa
DB_PASSWORD=your_sql_server_password

# 2. Cấu hình lưu trữ ảnh đám mây Cloudinary dùng chung của nhóm
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
