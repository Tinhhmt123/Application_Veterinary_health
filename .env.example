# Copy file này thành ".env" ở thư mục gốc Healthy_Pet và điền BASE_URL phù hợp với máy bạn:
# - Máy thật qua Wi-Fi cùng mạng: http://<IPv4_WiFi_Máy_Tính>:8080/api/
# - Máy thật qua cáp USB (`adb reverse tcp:8080 tcp:8080`): http://localhost:8080/api/
# - Máy ảo Android Emulator: http://10.0.2.2:8080/api/
BASE_URL=http://10.0.2.2:8080/api/

# Google OAuth 2.0 & Google Maps API (điền vào file .env cá nhân, không đẩy key thật lên Git)
GOOGLE_ANDROID_CLIENT_ID=your_android_oauth_client_id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
